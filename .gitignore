# Gitignore for LobeHub
################################################################

# System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux/Ubuntu system files
*~
*.swp
*.swo
.fuse_hidden*
.directory
.Trash-*
.nfs*
.gvfs-fuse-daemon-*

# IDE and editors
.idea/
*.sublime-*
.history/
.windsurfrules
*.code-workspace
.vscode/sessions.json
prd
# Recordings
.records/

# Agent-gateway probe captures (local debugging dumps)
.agent-gateway/

# Temporary files
.temp/
temp/
tmp/
*.tmp
*.temp
*.log
*.cache
.cache/

# Environment files
.env
.env.local
.env*.local
.env.development
.env.*
!.env.example
!.env.example.*
venv/
.venv/

# Dependencies
node_modules/
*.lock
package-lock.json
bun.lockb
.pnpm-store/

# Build outputs
dist/
public/canvas-runtime/
public/_spa/
public/_spa-auth/
public/_spa-share/
public/_spa-workbench/
public/spa/
es/
lib/
.next/
logs/
test-output/
*.tsbuildinfo
next-env.d.ts

# Framework specific
# Umi
.umi/
.umi-production/
.umi-test/
.dumi/tmp*/

# Vercel
.vercel/

# Testing and CI
coverage/
.coverage/
.nyc_output/
.eslintcache
.stylelintcache

# Service Worker
# Serwist
public/sw*
public/swe-worker*

# Generated files
src/app/spa/[variants]/[[...path]]/spaHtmlTemplates.ts
src/app/spa-auth/authHtmlTemplate.ts
src/app/spa-share/shareHtmlTemplate.ts
src/app/spa-workbench/workbenchHtmlTemplate.ts
public/*.js
robots.txt

# Git hooks
.githooks/prepare-commit-msg

# Documents and media
*.pdf

# Cloud service keys
vertex-ai-key.json

# Agent tracing snapshots
.agent-tracing/
.goal-tracing/
.llm-generation-tracing/

# AI coding tools
.local/
.claude/
.mcp.json
CLAUDE.local.md
.agent/

# MCP tools
.serena/**

# Docker development data
docker-compose/dev/data/

# Migration scripts data
.elasticsearch-reindex/

# Misc
./packages/lobe-ui
*.ppt*
*.doc*
*.xls*
e2e/reports
out
i18n-unused-keys-report.json
.vitest-reports
.vitest/

pnpm-lock.yaml
.turbo
spaHtmlTemplates.ts

# Embedded CLI bundle (built at pack time)
resources/bin/lobe-cli.js
resources/cli-package.json

# Superpowers plugin brainstorm/spec outputs (local only; do not commit)
.superpowers/
docs/superpowers/

# Local Ryugi artifacts and specifications
.ryugi/
docs/ryugi/
.heerogeneous-tracing

# Kagura agent runtime
.kagura/

# AUV computer-use runtime: run records plus captured screenshots, written
# relative to whatever directory the CLI was invoked from, so this can appear
# at the repo root or inside an app.
.auv/

# Amp agent runtime
.amp/

# synthesized by plugins/vite/completionSounds.ts
public/sounds/
resources/sounds/

# Generated by scripts/shellAbi.mjs --write
shell/abi.json
core-dist
harmony-app

# alint: local provider setup (holds the API key) and result cache
.alint/
.alintcache

# Packaged builtin desktop core
/core.asar
/core.asar.unpacked/

# 打包产物（AUV daemon 等，由 beforePack 生成）
resources/bin/
release/
